<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aboutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#152B28"
    android:padding="24dp"
    tools:context=".AboutActivity">

    <TextView
        android:id="@+id/txtAboutTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="About Quest Hunt"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtAboutDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Quest Hunt is a location-based scavenger hunt game where players explore interesting places, complete challenges, and track their progress."
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtAboutTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtFeaturesTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Game Features"
        android:textColor="#7DDE9A"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtAboutDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtFeatures"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="• Explore scavenger hunt locations&#10;• Complete location challenges&#10;• Track your progress&#10;• Play with a team"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:lineSpacingExtra="10dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtFeaturesTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtVersion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Version 0.1 - UI Prototype"
        android:textColor="#B9CECA"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtFeatures"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnBackFromAbout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
