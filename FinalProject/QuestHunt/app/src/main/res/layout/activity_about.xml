<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aboutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp"
    tools:context=".AboutActivity">

    <TextView
        android:id="@+id/txtAboutTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="About Quest Hunt"
        android:fontFamily="@font/qager"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtAboutDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Quest Hunt is a location based scavenger hunt game where players explore interesting places, complete challenges, and track their progress."
        android:fontFamily="@font/qager"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="center"
        android:background="@drawable/retro_panel_background"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/txtAboutTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtFeaturesTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Game Features"
        android:fontFamily="@font/qager"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/txtAboutDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtFeatures"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="• Explore scavenger hunt locations&#10;• Complete location challenges&#10;• Track your progress&#10;• Play with a team"
        android:fontFamily="@font/qager"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:lineSpacingExtra="10dp"
        android:background="@drawable/retro_panel_background"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtFeaturesTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtVersion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Version 0.2 - Functional Prototype"
        android:fontFamily="@font/qager"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtFeatures"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBackFromAbout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"
        android:minHeight="64dp"
        android:background="@drawable/retro_button_background"
        android:fontFamily="@font/qager"
        android:text="Back to Home"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
