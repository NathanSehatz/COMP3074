<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/teamMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp"
    tools:context=".TeamActivity">

    <TextView
        android:id="@+id/txtTeamTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="My Team"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtTeamSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Explore together, complete challenges!"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtTeamTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtTeamMembers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Team Members"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtTeamSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtMemberList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="1. Player One (Leader)&#10;2. Player Two&#10;3. Player Three"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:lineSpacingExtra="12dp"
        android:background="@drawable/retro_panel_background"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtTeamMembers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAddMember"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        android:minHeight="64dp"
        android:background="@drawable/retro_button_background"
        android:fontFamily="@font/qager"
        android:text="Add Team Member"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/txtMemberList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Spinner
        android:id="@+id/spinnerTeamMembers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        android:minHeight="56dp"
        android:spinnerMode="dropdown"
        android:dropDownVerticalOffset="8dp"
        android:background="@drawable/retro_spinner_background"
        android:popupBackground="#000000"
        app:layout_constraintTop_toBottomOf="@id/btnAddMember"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRemoveMember"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        android:minHeight="64dp"
        android:background="@drawable/retro_button_background"
        android:fontFamily="@font/qager"
        android:text="Remove Team Member"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/spinnerTeamMembers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBackFromTeam"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"
        android:minHeight="64dp"
        android:background="@drawable/retro_button_background"
        android:fontFamily="@font/qager"
        android:text="Back to Home"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>