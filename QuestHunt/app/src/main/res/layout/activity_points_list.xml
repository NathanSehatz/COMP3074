<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pointsMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#152B28"
    android:padding="24dp"
    tools:context=".PointsListActivity">

    <TextView
        android:id="@+id/txtPointsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Hunt Locations"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtPointsDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Choose a location to explore!"
        android:textColor="#B9CECA"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtPointsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnLocation1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Location 1 - City Park"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/txtPointsDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnLocation2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Location 2 - Museum"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnLocation1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnLocation3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Location 3 - Library"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnLocation2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
