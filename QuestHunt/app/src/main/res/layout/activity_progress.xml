<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#152B28"
    android:padding="24dp"
    tools:context=".ProgressActivity">

    <TextView
        android:id="@+id/txtProgressTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="My Progress"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtCompletedCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0 of 3 Challenges Completed"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtProgressTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#7DDE9A"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtCompletedCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtPercentage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0% Complete"
        android:textColor="#B9CECA"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtCityParkStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="City Park: Not Completed"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtPercentage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtMuseumStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Museum: Not Completed"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtCityParkStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtLibraryStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Library: Not Completed"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtMuseumStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnBackFromProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
